default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Requires App Store Connect API key (set via FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD or api_key)
    api_key = app_store_connect_api_key # expects FASTLANE_SESSION or a configured api key
    capture_build_number
    build_app(scheme: "BitcoinBankApp", export_method: "app-store")
    upload_to_testflight(api_key: api_key)
  end

  desc "Release to App Store"
  lane :release do
    api_key = app_store_connect_api_key
    capture_build_number
    build_app(scheme: "BitcoinBankApp", export_method: "app-store")
    upload_to_app_store(api_key: api_key)
  end
end

